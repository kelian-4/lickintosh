{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/logo.txt",
        "color": { "1": "white", "2": "blue", "3": "yellow", "4": "red", "5": "green" },
        "padding": { "top": 1, "left": 2, "right": 3 }
    },
    "display": {
        "separator": "  ",
        "key": { "width": 14 },
        "color": { "keys": "blue", "title": "magenta" },
        "percent": { "type": 2 },
        "size": { "binaryPrefix": "iec" }
    },
    "modules": [
        { "type": "custom", "format": "\u001b[90m╭──────────────────────────────────────────────╮\u001b[0m" },
        { "type": "custom", "key": "\u001b[90m│\u001b[0m", "format": "\u001b[1;35mLickintosh\u001b[0m  macOS Tahoe pour Hyprland" },
        { "type": "title", "key": "\u001b[90m│\u001b[35m Session" },
        { "type": "command", "key": "\u001b[90m│\u001b[35m Version", "text": "git -C ~/.config/quickshell describe --always --dirty 2>/dev/null || echo dev" },
        { "type": "custom", "format": "\u001b[90m├──────────────────────────────────────────────┤\u001b[0m" },
        { "type": "os", "key": "\u001b[90m│\u001b[33m Système" },
        { "type": "host", "key": "\u001b[90m│\u001b[33m Machine" },
        { "type": "kernel", "key": "\u001b[90m│\u001b[33m Noyau" },
        { "type": "uptime", "key": "\u001b[90m│\u001b[33m Activité" },
        { "type": "packages", "key": "\u001b[90m│\u001b[33m Paquets" },
        { "type": "custom", "format": "\u001b[90m├──────────────────────────────────────────────┤\u001b[0m" },
        { "type": "wm", "key": "\u001b[90m│\u001b[34m Compositeur" },
        { "type": "custom", "key": "\u001b[90m│\u001b[34m Interface", "format": "Quickshell" },
        { "type": "display", "key": "\u001b[90m│\u001b[34m Écran" },
        { "type": "icons", "key": "\u001b[90m│\u001b[34m Icônes" },
        { "type": "cursor", "key": "\u001b[90m│\u001b[34m Curseur" },
        { "type": "font", "key": "\u001b[90m│\u001b[34m Police" },
        { "type": "shell", "key": "\u001b[90m│\u001b[34m Shell" },
        { "type": "terminal", "key": "\u001b[90m│\u001b[34m Terminal" },
        { "type": "custom", "format": "\u001b[90m├──────────────────────────────────────────────┤\u001b[0m" },
        { "type": "cpu", "key": "\u001b[90m│\u001b[31m Processeur" },
        { "type": "gpu", "key": "\u001b[90m│\u001b[31m Graphismes" },
        { "type": "memory", "key": "\u001b[90m│\u001b[31m Mémoire" },
        { "type": "disk", "key": "\u001b[90m│\u001b[31m Disque", "folders": "/" },
        { "type": "battery", "key": "\u001b[90m│\u001b[31m Batterie" },
        { "type": "custom", "format": "\u001b[90m╰──────────────────────────────────────────────╯\u001b[0m" },
        { "type": "colors", "symbol": "circle", "paddingLeft": 1 }
    ]
}
